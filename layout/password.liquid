<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {% render 'theme-styles' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.replace('no-js', 'js'); window.CF = { settings: {} };</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
