<footer class="site-footer">
  <div class="page-width">
    {%- if section.settings.cta_heading != blank -%}
    <div class="footer__cta">
      <h2 class="h-1" data-split>{{ section.settings.cta_heading }}</h2>
      <div class="btn-row" data-reveal>
        <a class="btn btn--gold" href="{{ settings.weekly_collection.url | default: routes.all_products_collection_url }}">{% render 'icon', name: 'bag' %}{{ 'general.order_this_week' | t }}</a>
        {%- if section.settings.cta_link != blank -%}<a class="btn btn--ghost" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>{%- endif -%}
      </div>
    </div>
    {%- endif -%}
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}"><img src="{{ 'logo-mark.png' | asset_url }}" alt="" width="46" height="42" loading="lazy"><span class="wordmark__t" aria-hidden="true"><i>casa</i><b>FRESCA</b></span></a>
        {%- if section.settings.about != blank -%}<p class="muted" style="color:rgba(251,244,230,.66);margin-top:16px;max-width:34ch">{{ section.settings.about }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__h">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
              <ul class="footer__links">{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
            </div>
          {%- when 'contact' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__h">{{ block.settings.heading }}</h2>
              <ul class="footer__links">
                {%- if settings.contact_phone != blank -%}<li><a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ settings.contact_phone }}</a></li>{%- endif -%}
                {%- if settings.contact_email != blank -%}<li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>{%- endif -%}
                {%- if settings.contact_area != blank -%}<li style="color:rgba(251,244,230,.66)">{{ settings.contact_area }}</li>{%- endif -%}
                {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
                {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
              </ul>
            </div>
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
      <span>
        {%- for policy in shop.policies -%}{% unless forloop.first %} &middot; {% endunless %}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}
      </span>
    </div>
    <p class="footer__giant" aria-hidden="true">FRESCA</p>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "inline_richtext", "id": "cta_heading", "label": "Closing headline", "default": "Dinner's handled. <em>Every week.</em>" },
    { "type": "text", "id": "cta_label", "label": "Second button label", "default": "Plan catering" },
    { "type": "url", "id": "cta_link", "label": "Second button link" },
    { "type": "textarea", "id": "about", "label": "Short about text", "default": "Chef-made meal prep and catering from Crawfordsville, Indiana." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ]},
    { "type": "contact", "name": "Contact", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Say hello" }
    ]},
    { "type": "@app" }
  ]
}
{% endschema %}
