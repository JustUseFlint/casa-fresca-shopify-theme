{%- liquid
  assign main_links = section.blocks | where: 'type', 'link'
  assign more_links = section.blocks | where: 'type', 'more'
-%}
<header class="site-header" data-header>
  <div class="page-width header__in">
    {% render 'wordmark' %}
    <nav aria-label="{{ 'general.primary_nav' | t }}">
      <ul class="header__nav">
        {%- for block in main_links -%}
          <li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}"{% if block.settings.url == request.path %} aria-current="page"{% endif %}>{{ block.settings.label }}</a></li>
        {%- endfor -%}
        {%- if more_links.size > 0 -%}
          <li>
            <details data-hover-menu>
              <summary>{{ section.settings.more_label }}{% render 'icon', name: 'chevron' %}</summary>
              <ul class="header__sub">
                {%- for block in more_links -%}<li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}"{% if block.settings.url == request.path %} aria-current="page"{% endif %}>{{ block.settings.label }}</a></li>{%- endfor -%}
              </ul>
            </details>
          </li>
        {%- endif -%}
      </ul>
    </nav>
    <div class="header__actions">
      <a class="cart-btn" href="{{ routes.cart_url }}" data-cart-open aria-haspopup="dialog" aria-controls="CartDrawer" aria-expanded="false">
        {% render 'icon', name: 'bag' %}
        <span class="visually-hidden">{{ 'cart.title' | t }},</span>
        <span class="cart-btn__total" data-cart-total>{{ cart.total_price | money }}</span>
        <span class="cart-btn__count" data-cart-count aria-label="{{ 'cart.count_label' | t }}">{{ cart.item_count }}</span>
      </a>
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu" aria-label="{{ 'general.menu' | t }}"><i></i><i></i></button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="MobileMenu" data-mobile-menu aria-hidden="true">
  <ul class="mobile-menu__links">
    {%- for block in main_links -%}
      <li class="mm-item" style="--i: {{ forloop.index0 }}"><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>
    {%- endfor -%}
    {%- if more_links.size > 0 -%}
      <li class="mm-item" style="--i: {{ main_links.size }}">
        <details>
          <summary>{{ section.settings.more_label }}{% render 'icon', name: 'plus' %}</summary>
          <ul>{%- for block in more_links -%}<li><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>{%- endfor -%}</ul>
        </details>
      </li>
    {%- endif -%}
  </ul>
  <div class="mobile-menu__foot mm-item" style="--i: {{ main_links.size | plus: 1 }}">
    {% render 'cutoff' %}
    {%- if settings.contact_phone != blank -%}<a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ settings.contact_phone }}</a>{%- endif -%}
    <div class="btn-row">
      <a class="btn btn--tomato" href="{{ settings.weekly_collection.url | default: routes.all_products_collection_url }}">{% render 'icon', name: 'bag' %}{{ 'general.order_this_week' | t }}</a>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "paragraph", "content": "Links are set here, not in Navigation, so the header only ever points at pages in this theme." },
    { "type": "text", "id": "more_label", "label": "Dropdown label", "default": "More" }
  ],
  "blocks": [
    { "type": "link", "name": "Link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Link" },
      { "type": "url", "id": "url", "label": "Link" }
    ]},
    { "type": "more", "name": "Dropdown link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Link" },
      { "type": "url", "id": "url", "label": "Link" }
    ]}
  ]
}
{% endschema %}
