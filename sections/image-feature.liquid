{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.product != blank
    for i in section.settings.product.images
      assign s = i.src | downcase
      unless s contains 'nutrition' or s contains 'label' or s contains 'gps_generated'
        assign img = i
        break
      endunless
    endfor
  endif
-%}
<section class="section{% if section.settings.dark %} section--dark{% endif %}" aria-labelledby="FeatH-{{ section.id }}">
  <div class="page-width feature{% if section.settings.flip %} feature--flip{% endif %}">
    <div class="feature__media" data-reveal="img">
      {%- if img != blank -%}
        <img src="{{ img | image_url: width: 1200 }}" srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1300 }} 1300w" sizes="(min-width: 990px) 50vw, 100vw" width="{{ img.width }}" height="{{ img.height }}" alt="{{ img.alt | escape }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="feature__body">
      {%- if section.settings.kicker != blank -%}<p class="kicker" data-reveal>{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h-1" id="FeatH-{{ section.id }}" data-split>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lede rte" data-reveal>{{ section.settings.text }}</div>{%- endif -%}
      {%- assign facts = section.blocks | where: 'type', 'fact' -%}
      {%- if facts.size > 0 -%}
        <div class="facts" data-stagger>
          {%- for block in facts -%}<div class="fact" data-reveal {{ block.shopify_attributes }}><b>{{ block.settings.big }}</b><span>{{ block.settings.small }}</span></div>{%- endfor -%}
        </div>
      {%- endif -%}
      <div class="btn-row" data-reveal>
        {%- if section.settings.button_label != blank -%}<a class="btn {% if section.settings.dark %}btn--gold{% else %}btn--tomato{% endif %}" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "product", "label": "Or use a meal's photo", "info": "Used when no image is picked." },
    { "type": "text", "id": "kicker", "label": "Small heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Catering, <em>made the same way</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": true },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "limit": 4, "settings": [
      { "type": "text", "id": "big", "label": "Big text", "default": "160" },
      { "type": "text", "id": "small", "label": "Small text", "default": "guests at one dinner" }
    ]}
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
