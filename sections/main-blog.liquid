{%- paginate blog.articles by 9 -%}
<section class="section" style="padding-top:clamp(40px,7vw,96px)">
  <div class="page-width">
    <div class="blog-head">
      {%- if section.settings.kicker != blank -%}<p class="kicker" data-reveal>{{ section.settings.kicker }}</p>{%- endif -%}
      <h1 class="h-1" data-split>{{ blog.title }}</h1>
      {%- if section.settings.blog_1 != blank and section.settings.blog_2 != blank -%}
        <nav class="coll-tabs" aria-label="{{ section.settings.kicker | escape }}" data-reveal>
          {%- for b in (1..2) -%}{%- assign key = 'blog_' | append: b -%}{%- assign bb = section.settings[key] -%}{%- assign lk = key | append: '_label' -%}
            <a class="tab" href="{{ bb.url }}"{% if bb.handle == blog.handle %} aria-current="page"{% endif %}>{{ section.settings[lk] | default: bb.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
    <div class="posts" data-stagger>
      {%- for article in blog.articles -%}
        <a class="post" href="{{ article.url }}" data-reveal>
          <div class="post__img">{%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w" sizes="(min-width: 1100px) 33vw, (min-width: 750px) 50vw, 100vw" width="{{ article.image.width }}" height="{{ article.image.height }}" alt="{{ article.image.alt | escape }}" loading="lazy">{%- endif -%}</div>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
          <h2 class="h-3">{{ article.title }}</h2>
          <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog posts", "settings": [
  { "type": "text", "id": "kicker", "label": "Small heading", "default": "From the kitchen" },
  { "type": "blog", "id": "blog_1", "label": "First tab" },
  { "type": "text", "id": "blog_1_label", "label": "First tab label", "default": "Blog" },
  { "type": "blog", "id": "blog_2", "label": "Second tab" },
  { "type": "text", "id": "blog_2_label", "label": "Second tab label", "default": "Recipes" }
] }
{% endschema %}
