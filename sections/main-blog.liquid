{%- paginate blog.articles by 9 -%}
<section class="section" style="padding-top:clamp(40px,7vw,96px)">
  <div class="page-width">
    <h1 class="h-1" data-split style="margin-bottom:clamp(26px,4vw,48px)">{{ blog.title }}</h1>
    <div class="posts" data-stagger>
      {%- for article in blog.articles -%}
        <a class="post" href="{{ article.url }}" data-reveal>
          <div class="post__img">{%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w" sizes="(min-width: 1100px) 33vw, (min-width: 750px) 50vw, 100vw" width="{{ article.image.width }}" height="{{ article.image.height }}" alt="{{ article.image.alt | escape }}" loading="lazy">{%- endif -%}</div>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
          <h2 class="h-3">{{ article.title }}</h2>
          <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
