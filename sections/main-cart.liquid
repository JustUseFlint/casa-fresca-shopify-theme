<section class="section" style="padding-top:clamp(36px,6vw,80px)" data-cart-page>
  <div class="page-width">
    <h1 class="h-1" data-split style="margin-bottom:clamp(24px,4vw,44px)">{{ 'cart.your_week' | t }}</h1>
    <div data-cart-empty{% if cart.item_count > 0 %} hidden{% endif %} class="empty" style="justify-items:start;text-align:left;padding-top:0">
      <p class="h-3">{{ 'cart.empty' | t }}</p>
      <p class="muted">{{ 'cart.empty_text' | t }}</p>
      {%- if settings.weekly_collection != blank -%}<a class="btn btn--tomato" href="{{ settings.weekly_collection.url }}">{{ 'general.see_this_week' | t }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    <form action="{{ routes.cart_url }}" method="post" class="cart-page" data-cart-filled{% if cart.item_count == 0 %} hidden{% endif %}>
      <div>
        <ul data-cart-lines>
          {%- for item in cart.items -%}
            <li class="line" data-line="{{ item.key }}">
              <a class="line__img" href="{{ item.url }}" tabindex="-1">{%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="" width="76" height="76" loading="lazy">{%- endif -%}</a>
              <div>
                <div class="line__top"><div><a class="line__title" href="{{ item.url }}">{{ item.product.title }}</a>{%- unless item.product.has_only_default_variant -%}<div class="line__variant">{{ item.variant.title }}</div>{%- endunless -%}</div><div class="line__price">{{ item.final_line_price | money }}</div></div>
                <div class="line__ctrl"><label class="visually-hidden" for="Q-{{ item.key }}">{{ 'cart.quantity' | t }}</label><input class="input" style="width:90px;min-height:42px" type="number" min="0" id="Q-{{ item.key }}" name="updates[]" value="{{ item.quantity }}"><a class="line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <noscript><button type="submit" class="btn btn--ghost" style="margin-top:16px">{{ 'cart.update' | t }}</button></noscript>
        {%- for block in section.blocks -%}<div {{ block.shopify_attributes }} style="margin-top:20px">{% render block %}</div>{%- endfor -%}
      </div>
      <div class="cart-summary">
        {% render 'cutoff', show_ready: true, compact: true %}
        {%- if section.settings.show_note -%}
          <div class="field"><label for="CartNote">{{ 'cart.note' | t }}</label><textarea class="input" id="CartNote" name="note" data-cart-note placeholder="{{ 'cart.note_placeholder' | t }}">{{ cart.note }}</textarea></div>
        {%- endif -%}
        <div class="drawer__total"><span>{{ 'cart.subtotal' | t }}<small>{{ 'cart.taxes' | t }}</small></span><span data-cart-total>{{ cart.total_price | money }}</span></div>
        <button type="submit" name="checkout" class="btn btn--tomato btn--block" data-checkout>{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow' %}</button>
        {%- if additional_checkout_buttons and section.settings.dynamic_checkout -%}<div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
      </div>
    </form>
  </div>
</section>
{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order special instructions", "default": true },
    { "type": "checkbox", "id": "dynamic_checkout", "label": "Show Shop Pay and other express buttons", "default": true }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
