<section class="section" style="min-height:80vh;display:grid;align-items:center">
  <div class="page-width" style="display:grid;gap:22px;justify-items:center;text-align:center">
    {% render 'wordmark' %}
    <h1 class="h-1" data-split>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message }}</p>{%- endif -%}
    <details style="width:100%;max-width:420px">
      <summary class="link" style="cursor:pointer;display:inline">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'auth', style: 'margin-top:18px' -%}
        {%- if form.errors -%}<div class="form-msg form-msg--err">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
        <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
        <button class="btn btn--tomato" type="submit">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [{ "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The next menu is <em>almost ready</em>" }] }
{% endschema %}
