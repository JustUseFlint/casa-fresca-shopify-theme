<section class="section"><div class="page-width"><div class="auth">
  <h1 class="h-1" data-split>{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'auth' -%}
    {%- if form.errors -%}<div class="form-msg form-msg--err">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="RP1">{{ 'password.label' | t }}</label><input class="input" type="password" name="customer[password]" id="RP1" autocomplete="new-password"></div>
    <div class="field"><label for="RP2">{{ 'customer.confirm' | t }}</label><input class="input" type="password" name="customer[password_confirmation]" id="RP2" autocomplete="new-password"></div>
    <button class="btn btn--tomato btn--block" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</div></div></section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
