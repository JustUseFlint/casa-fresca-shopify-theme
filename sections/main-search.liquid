{%- comment -%} Site search is switched off in this theme. Meals are searched from the menu pages instead. {%- endcomment -%}
<section class="section">
  <div class="page-width empty" style="min-height:50vh;align-content:center">
    <p class="kicker">{{ 'general.order_this_week' | t }}</p>
    <h1 class="h-2">{{ 'search.moved' | t }}</h1>
    <div class="btn-row" style="justify-content:center">
      <a class="btn btn--tomato" href="{{ settings.weekly_collection.url | default: routes.all_products_collection_url }}">{{ 'collections.this_week' | t }}</a>
      {%- if settings.all_collection != blank -%}<a class="btn btn--ghost" href="{{ settings.all_collection.url }}">{{ 'collections.all_meals' | t }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
