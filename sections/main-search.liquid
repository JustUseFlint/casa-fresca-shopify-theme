{%- paginate search.results by 24 -%}
<section class="section" style="padding-top:clamp(40px,7vw,96px)">
  <div class="page-width">
    <h1 class="h-1" data-split style="margin-bottom:24px">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;max-width:640px;margin-bottom:36px" data-search-form>
      <label class="visually-hidden" for="SearchQ">{{ 'search.label' | t }}</label>
      <input class="input" type="search" id="SearchQ" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
      <input type="hidden" name="type" value="product">
      <button class="btn btn--tomato" type="submit">{% render 'icon', name: 'search' %}<span class="visually-hidden">{{ 'general.search' | t }}</span></button>
    </form>
    {%- if search.performed -%}
      <p class="muted" style="margin-bottom:22px" role="status">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="meal-grid" data-stagger data-grid>
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'meal-card', product: item, sid: section.id %}{%- endif -%}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
