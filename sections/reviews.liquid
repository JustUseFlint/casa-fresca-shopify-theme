<section class="section" aria-labelledby="RevH-{{ section.id }}">
  <div class="page-width">
    <div class="sec-head sec-head--row">
      <div style="display:grid;gap:14px">
        {%- if section.settings.kicker != blank -%}<p class="kicker" data-reveal>{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="h-2" id="RevH-{{ section.id }}" data-split>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.rating != blank -%}
        <p class="rating-line" data-reveal><span class="stars" aria-hidden="true">{% for i in (1..5) %}{% render 'icon', name: 'star' %}{% endfor %}</span><span>{{ section.settings.rating }}</span></p>
      {%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
  <div class="marquee" data-reveal style="--dur: {{ section.blocks.size | times: 11 }}s">
    <div class="marquee__track">
      {%- for pass in (1..2) -%}
        {%- for block in section.blocks -%}
          <figure class="quote"{% if pass == 2 %} aria-hidden="true"{% else %} {{ block.shopify_attributes }}{% endif %}>
            <blockquote><p>&ldquo;{{ block.settings.quote }}&rdquo;</p></blockquote>
            <footer><b>{{ block.settings.author }}</b>{% if block.settings.source != blank %} &middot; {{ block.settings.source }}{% endif %}</footer>
          </figure>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}
  {%- for block in section.blocks -%}{%- if block.type == '@app' -%}<div class="page-width" style="margin-top:28px">{% render block %}</div>{%- endif -%}{%- endfor -%}
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "From our regulars" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Fresh, filling and <em>as advertised</em>" },
    { "type": "text", "id": "rating", "label": "Rating line", "default": "5.0 on Google" }
  ],
  "blocks": [
    { "type": "quote", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "author", "label": "Name" },
      { "type": "text", "id": "source", "label": "Source", "default": "Google review" }
    ]},
    { "type": "@app" }
  ],
  "presets": [{ "name": "Reviews", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }]
}
{% endschema %}
