{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections['weekly-meals']
  endif
  assign limit = section.settings.limit
-%}
<section class="menu-hero" id="this-week" aria-labelledby="WeekH-{{ section.id }}">
  <div class="page-width">
    <div class="menu-hero__grid">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="kicker" data-reveal>{{ section.settings.kicker }}</p>{%- endif -%}
        <h1 class="h-display" id="WeekH-{{ section.id }}" data-split>{{ section.settings.heading }}</h1>
      </div>
      <div class="menu-hero__meta" data-reveal style="--d:200">
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
        {%- if settings.orders_paused -%}
          <p class="paused-note">{{ settings.paused_message }}</p>
        {%- else -%}
          <div class="week-card">
            <span class="week-card__lbl">{{ 'ordering.order_by' | t }}</span><span class="week-card__val" data-cutoff-date>{{ settings.cutoff_fallback }}</span>
            <span class="week-card__lbl">{{ 'ordering.ready' | t }}</span><span class="week-card__val" data-ready-date>{{ settings.ready_fallback }}</span>
            <span class="cutoff"><span class="cutoff__dot"></span><span class="cutoff__left" data-cutoff-left></span></span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<section class="section--tight" style="padding-top:0">
  <div class="page-width">
    {%- if coll.products_count > 0 -%}
      <div class="meal-grid" data-stagger>
        {%- for product in coll.products limit: limit -%}
          {%- liquid
            assign eager = false
            if forloop.index <= 2
              assign eager = true
            endif
          -%}
          {% render 'meal-card', product: product, show_description: section.settings.show_description, eager: eager, sid: section.id %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty">
        <p class="h-3">{{ 'collections.empty_week' | t }}</p>
        {%- if settings.social_facebook != blank -%}<a class="link-arrow" href="{{ settings.social_facebook }}" target="_blank" rel="noopener">{{ 'collections.follow' | t }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="btn-row" style="margin-top:34px;justify-content:center" data-reveal>
      {%- if section.settings.all_link != blank -%}<a class="btn btn--ghost" href="{{ section.settings.all_link }}">{{ section.settings.all_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "This week's menu",
  "tag": "div",
  "class": "section-weekly-menu",
  "settings": [
    { "type": "collection", "id": "collection", "label": "This week's menu", "info": "The collection you add each week's meals to. Casa Fresca uses \"Weekly Meals\"." },
    { "type": "range", "id": "limit", "label": "Meals to show", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "This week's menu" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Cooked fresh, <em>ready Tuesday.</em>" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Pick your meals, choose your base and check out in a minute. Heat for two or three minutes and eat." },
    { "type": "checkbox", "id": "show_description", "label": "Show short descriptions", "default": true },
    { "type": "url", "id": "all_link", "label": "Browse-all link" },
    { "type": "text", "id": "all_label", "label": "Browse-all label", "default": "See every meal we make" }
  ],
  "presets": [{ "name": "This week's menu" }]
}
{% endschema %}
