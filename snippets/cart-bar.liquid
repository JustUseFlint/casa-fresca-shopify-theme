{%- comment -%} Floating cart pill: same look as the header cart button. Shows on every page once the cart has items. {%- endcomment -%}
{%- if settings.show_cart_bar -%}
<button type="button" class="cart-pill{% if cart.item_count > 0 %} is-visible is-instant{% endif %}" data-cart-bar data-cart-open aria-haspopup="dialog" aria-controls="CartDrawer" aria-expanded="false">
  {% render 'icon', name: 'bag' %}
  <span class="cart-pill__label">{{ 'cart.view' | t }}</span>
  <span class="cart-pill__total" data-cart-total>{{ cart.total_price | money }}</span>
  <span class="cart-btn__count" data-cart-count>{{ cart.item_count }}</span>
  <span class="visually-hidden"><span data-cart-label>{% if cart.item_count == 1 %}{{ 'cart.meal_one' | t }}{% else %}{{ 'cart.meal_other' | t }}{% endif %}</span></span>
</button>
{%- endif -%}
