{%- comment -%} Mobile-only sticky bar: Cart · N · $X · Checkout {%- endcomment -%}
{%- if settings.show_cart_bar -%}
<div class="cart-bar{% if cart.item_count > 0 %} is-visible{% endif %}" data-cart-bar>
  <button type="button" class="cart-bar__open" data-cart-open aria-haspopup="dialog" aria-controls="CartDrawer" aria-expanded="false">
    {% render 'icon', name: 'bag' %}
    <span>{{ 'cart.title' | t }}</span><span class="sep" aria-hidden="true">&middot;</span>
    <span><span data-cart-count>{{ cart.item_count }}</span> <span data-cart-label>{% if cart.item_count == 1 %}{{ 'cart.meal_one' | t }}{% else %}{{ 'cart.meal_other' | t }}{% endif %}</span></span><span class="sep" aria-hidden="true">&middot;</span>
    <span data-cart-total>{{ cart.total_price | money }}</span>
  </button>
  <a class="btn btn--gold cart-bar__checkout" href="{{ routes.root_url }}checkout" data-checkout>{{ 'cart.checkout' | t }}</a>
</div>
{%- endif -%}
