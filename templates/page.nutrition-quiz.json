    "quiz": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .quiz-container {\n    background-color: #FEF7EA;\n    color: #000000;\n    max-width: 600px;\n    margin: 20px auto;\n    padding: 20px;\n    border-radius: 8px;\n    font-family: Arial, sans-serif;\n  }\n  .quiz-container h2 {\n    color: #F45341;\n    text-align: center;\n  }\n  .question {\n    margin-bottom: 20px;\n  }\n  .question p {\n    font-weight: bold;\n    margin-bottom: 10px;\n  }\n  .option {\n    display: block;\n    margin: 5px 0;\n  }\n  .option input[type=\"radio\"] {\n    accent-color: #F1B435;\n  }\n  .option label {\n    margin-left: 5px;\n    cursor: pointer;\n  }\n  #submit-quiz {\n    background-color: #F1B435;\n    color: #000000;\n    border: none;\n    padding: 10px 20px;\n    border-radius: 5px;\n    cursor: pointer;\n    display: block;\n    margin: 20px auto;\n    font-size: 16px;\n  }\n  #submit-quiz:hover {\n    background-color: #F45341;\n    color: #FEF7EA;\n  }\n  #quiz-results {\n    text-align: center;\n    display: none;\n  }\n  #quiz-results h3 {\n    color: #F45341;\n  }\n  #quiz-results p {\n    color: #000000;\n  }\n</style>\n<div class=\"quiz-container\">\n<h2>Find Your Perfect Casa Fresca Meal</h2>\n<form id=\"nutrition-quiz\">\n<div id=\"quiz-questions\"></div>\n<button id=\"submit-quiz\" type=\"button\">Get Your Meal Match</button>\n</form>\n<div id=\"quiz-results\"></div>\n</div>\n<script>\n  const allQuestions = [\n    {\n      question: \"What's your primary dietary goal?\",\n      options: [\"Lose weight\", \"Build muscle\", \"Maintain health\", \"Boost energy\"],\n      key: \"goal\"\n    },\n    {\n      question: \"How spicy do you like your food?\",\n      options: [\"Not at all\", \"Mild\", \"Medium\", \"Very spicy\"],\n      key: \"spice\"\n    },\n    {\n      question: \"Which protein do you prefer?\",\n      options: [\"Chicken\", \"Beef\", \"Fish\", \"Plant-based\"],\n      key: \"protein\"\n    },\n    {\n      question: \"How active are you?\",\n      options: [\"Sedentary\", \"Lightly active\", \"Moderately active\", \"Very active\"],\n      key: \"activity\"\n    },\n    {\n      question: \"Any dietary restrictions?\",\n      options: [\"None\", \"Gluten-free\", \"Dairy-free\", \"Nut-free\"],\n      key: \"restriction\"\n    },\n    {\n      question: \"What's your favorite flavor profile?\",\n      options: [\"Savory\", \"Sweet\", \"Tangy\", \"Herbaceous\"],\n      key: \"flavor\"\n    },\n    {\n      question: \"How many meals do you eat daily?\",\n      options: [\"2 or fewer\", \"3\", \"4\", \"5 or more\"],\n      key: \"meals\"\n    },\n    {\n      question: \"Do you prefer carbs or fats for energy?\",\n      options: [\"Carbs\", \"Fats\", \"Balanced\", \"No preference\"],\n      key: \"energy\"\n    },\n    {\n      question: \"What's your cooking skill level?\",\n      options: [\"Beginner\", \"Intermediate\", \"Advanced\", \"I don’t cook\"],\n      key: \"cooking\"\n    },\n    {\n      question: \"When do you eat your biggest meal?\",\n      options: [\"Breakfast\", \"Lunch\", \"Dinner\", \"Snacks throughout\"],\n      key: \"timing\"\n    }\n  ];\n\n  function shuffleArray(array) {\n    for (let i = array.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [array[i], array[j]] = [array[j], array[i]];\n    }\n    return array;\n  }\n\n  function loadQuiz() {\n    const quizContainer = document.getElementById(\"quiz-questions\");\n    const selectedQuestions = shuffleArray([...allQuestions]).slice(0, 5);\n    \n    selectedQuestions.forEach((q, index) => {\n      const questionDiv = document.createElement(\"div\");\n      questionDiv.className = \"question\";\n      questionDiv.innerHTML = `<p>${index + 1}. ${q.question}</p>`;\n      \n      q.options.forEach((option, optIndex) => {\n        const optionHtml = `\n          <div class=\"option\">\n            <input type=\"radio\" name=\"q${index}\" id=\"q${index}_${optIndex}\" value=\"${option}\" required>\n            <label for=\"q${index}_${optIndex}\">${option}</label>\n          </div>\n        `;\n        questionDiv.innerHTML += optionHtml;\n      });\n      \n      quizContainer.appendChild(questionDiv);\n    });\n  }\n\n  function getResults() {\n    const form = document.getElementById(\"nutrition-quiz\");\n    const resultsDiv = document.getElementById(\"quiz-results\");\n    const answers = new FormData(form);\n    let suggestions = [];\n\n    for (let [key, value] of answers) {\n      // Goal-based recommendations\n      if (value === \"Lose weight\") suggestions.push(\"Chicken Tortilla Soup\", \"Asian Zing Ground Turkey\");\n      if (value === \"Build muscle\") suggestions.push(\"Protein Pancakes\", \"Steak Burrito Bowl\");\n      if (value === \"Maintain health\") suggestions.push(\"Chicken Florentine\", \"Broccoli and Cheese Stuffed Chicken\");\n      if (value === \"Boost energy\") suggestions.push(\"BBQ Pulled Chicken Mac n Cheese\", \"Orange Chicken and Rice\");\n\n      // Spice preferences\n      if (value === \"Not at all\") suggestions.push(\"Creamy Chicken and Wild Rice Soup\", \"Cookies & Cream Overnight Oats\");\n      if (value === \"Mild\") suggestions.push(\"Chicken and Dumpling Soup\", \"Brown Sugar Dijon Glazed Salmon\");\n      if (value === \"Medium\") suggestions.push(\"Orange Chicken and Rice\", \"Chicken Pesto Fettuccine\");\n      if (value === \"Very spicy\") suggestions.push(\"Chicken Enchiladas\", \"Steak Burrito Bowl\");\n\n      // Protein preferences\n      if (value === \"Chicken\") suggestions.push(\"Creamy Mushroom Chicken\", \"Chicken Enchiladas\");\n      if (value === \"Beef\") suggestions.push(\"Asian Beef and Broccoli\", \"Beef Lasagna\");\n      if (value === \"Fish\") suggestions.push(\"Yum Yum Salmon\", \"Shrimp Scampi\");\n      if (value === \"Plant-based\") suggestions.push(\"Cookies & Cream Overnight Oats\", \"Cinnamon Roll Overnight Oats\");\n\n      // Activity level\n      if (value === \"Sedentary\") suggestions.push(\"Chicken Florentine\", \"Creamy Chicken and Wild Rice Soup\");\n      if (value === \"Very active\") suggestions.push(\"Protein Pancakes\", \"Chicken Pesto Fettuccine\");\n\n      // Dietary restrictions\n      if (value === \"Gluten-free\") suggestions.push(\"Orange Chicken and Rice\", \"Chicken Tortilla Soup\");\n      if (value === \"Dairy-free\") suggestions.push(\"Asian Beef and Broccoli\", \"Steak Burrito Bowl\");\n      if (value === \"Nut-free\") suggestions.push(\"Chicken Enchiladas\", \"Shrimp Scampi\");\n\n      // Flavor preferences\n      if (value === \"Savory\") suggestions.push(\"Beef Lasagna\", \"Creamy Chicken Sausage Orzo\");\n      if (value === \"Sweet\") suggestions.push(\"Honey Walnut Shrimp\", \"Cinnamon Roll Overnight Oats\");\n      if (value === \"Tangy\") suggestions.push(\"Orange Chicken and Rice\", \"Brown Sugar Dijon Glazed Salmon\");\n      if (value === \"Herbaceous\") suggestions.push(\"Chicken Florentine\", \"Chicken Pesto Fettuccine\");\n\n      // Energy preferences\n      if (value === \"Carbs\") suggestions.push(\"BBQ Pulled Chicken Mac n Cheese\", \"Beef Lasagna\");\n      if (value === \"Fats\") suggestions.push(\"Creamy Mushroom Chicken\", \"Broccoli and Cheese Stuffed Chicken\");\n\n      // Timing preferences\n      if (value === \"Breakfast\") suggestions.push(\"Protein Pancakes\", \"Cinnamon Roll Overnight Oats\");\n      if (value === \"Dinner\") suggestions.push(\"Creamy Chicken Sausage Orzo\", \"Asian Beef and Broccoli\");\n    }\n\n    // Deduplicate and limit suggestions\n    suggestions = [...new Set(suggestions)].slice(0, 3); // Limit to 3 unique suggestions\n    if (suggestions.length === 0) {\n      suggestions.push(\"Orange Chicken and Rice\", \"Chicken Tortilla Soup\"); // Fallback\n    }\n\n    resultsDiv.innerHTML = `\n      <h3>Your Meal Matches</h3>\n      <p>${suggestions.join(\"<br>\")}</p>\n      <p>Order these delicious options from our menu now!</p>\n    `;\n    resultsDiv.style.display = \"block\";\n    document.getElementById(\"submit-quiz\").style.display = \"none\";\n  }\n\n  document.addEventListener(\"DOMContentLoaded\", loadQuiz);\n  document.getElementById(\"submit-quiz\").addEventListener(\"click\", getResults);\n</script>"
      }
